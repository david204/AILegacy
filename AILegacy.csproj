<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AILegacy</AssemblyName>
    <RootNamespace>AILegacy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.38.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <!-- Carpeta del juego (este proyecto vive dentro de ella) -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..</GameDir>
    <GameBin>$(GameDir)\bin\Win64_Shipping_Client</GameBin>
    <ModuleDir>$(GameDir)\Modules\AILegacy</ModuleDir>
    <OutputPath>$(ModuleDir)\bin\Win64_Shipping_Client\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Module\**;libs\**" />
    <None Remove="Module\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite compilar net472 sin Visual Studio -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameBin)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Core"><HintPath>$(GameBin)\TaleWorlds.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameBin)\TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Localization"><HintPath>$(GameBin)\TaleWorlds.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ObjectSystem"><HintPath>$(GameBin)\TaleWorlds.ObjectSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.SaveSystem"><HintPath>$(GameBin)\TaleWorlds.SaveSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.CampaignSystem"><HintPath>$(GameBin)\TaleWorlds.CampaignSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade"><HintPath>$(GameBin)\TaleWorlds.MountAndBlade.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine"><HintPath>$(GameBin)\TaleWorlds.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MCMv5"><HintPath>$(GameDir)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.InputSystem"><HintPath>$(GameBin)\TaleWorlds.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.ScreenSystem"><HintPath>$(GameBin)\TaleWorlds.ScreenSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI"><HintPath>$(GameBin)\TaleWorlds.Engine.GauntletUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="0Harmony"><HintPath>$(GameDir)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox"><HintPath>$(GameDir)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade.View"><HintPath>$(GameDir)\Modules\Native\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.View.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SandBox.View"><HintPath>$(GameDir)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.View.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.MountAndBlade.ViewModelCollection"><HintPath>$(GameBin)\TaleWorlds.MountAndBlade.ViewModelCollection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>libs\webview2\Microsoft.Web.WebView2.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>libs\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="TaleWorlds.DotNet"><HintPath>$(GameBin)\TaleWorlds.DotNet.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copia SubModule.xml y, solo si no existe, la config de ejemplo -->
  <ItemGroup><LangFiles Include="Module\ModuleData\Languages\**\*.xml" /><GuiPrefabs Include="Module\GUI\Prefabs\*.xml" /><GuiBrushes Include="Module\GUI\Brushes\*.xml" /></ItemGroup>
  <Target Name="CopyModuleFiles" AfterTargets="Build">
    <Copy SourceFiles="Module\SubModule.xml" DestinationFolder="$(ModuleDir)" />
    <Copy SourceFiles="@(GuiPrefabs)" DestinationFolder="$(ModuleDir)\GUI\Prefabs" />
    <Copy SourceFiles="@(GuiBrushes)" DestinationFolder="$(ModuleDir)\GUI\Brushes" />
    <Copy SourceFiles="Module\web\editor.html" DestinationFolder="$(ModuleDir)\web" />
    <Copy SourceFiles="@(LangFiles)" DestinationFiles="@(LangFiles->'$(ModuleDir)\ModuleData\AILegacyTexts\%(RecursiveDir)%(Filename)%(Extension)')" />
    <!-- Hasta la v0.29.1 iban en ModuleData\Languages y el juego los cargaba por su cuenta: fuera -->
    <RemoveDir Directories="$(ModuleDir)\ModuleData\Languages" />
    <Copy SourceFiles="libs\webview2\WebView2Loader.dll" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="libs\webview2\runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(OutputPath)runtimes\win-x64\native" />
    <Copy SourceFiles="Module\config.example.json" DestinationFolder="$(ModuleDir)" />
    <Copy SourceFiles="Module\config.example.json" DestinationFiles="$(ModuleDir)\config.json" Condition="!Exists('$(ModuleDir)\config.json')" />
    <Copy SourceFiles="Module\world_data\info.json" DestinationFiles="$(ModuleDir)\world_data\info.json" Condition="!Exists('$(ModuleDir)\world_data\info.json')" />
    <Copy SourceFiles="Module\world_data\secrets.json" DestinationFiles="$(ModuleDir)\world_data\secrets.json" Condition="!Exists('$(ModuleDir)\world_data\secrets.json')" />
    <Copy SourceFiles="Module\world.txt" DestinationFiles="$(ModuleDir)\world.txt" Condition="!Exists('$(ModuleDir)\world.txt')" />
  </Target>

</Project>
