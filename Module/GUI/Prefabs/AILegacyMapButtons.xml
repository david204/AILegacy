<Prefab>
  <Window>
    <!-- Capa del mapa: solo los botones aceptan clics; el resto del mapa sigue funcionando -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>

        <!-- Arriba a la derecha: noticias / eventos del mundo -->
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="15" MarginRight="20" Brush="ButtonBrush1" UpdateChildrenStates="true" Command.Click="ExecuteNews" IsVisible="@IsVisible">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@NewsText" />
          </Children>
        </ButtonWidget>

        <!-- Encargos de la IA y documentos, a la izquierda del de noticias -->
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="15" MarginRight="190" Brush="ButtonBrush1" UpdateChildrenStates="true" Command.Click="ExecuteQuests" IsVisible="false">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@QuestsText" />
          </Children>
        </ButtonWidget>

        <!-- El libro de memorias va dentro de la barra del mapa (Patches/MapBarPatch.cs) -->

      </Children>
    </Widget>
  </Window>
</Prefab>
