<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1180" SuggestedHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" />

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="30" MarginRight="30" MarginTop="18" MarginBottom="20" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="62" Brush="Popup.Title.Text" Brush.FontSize="40" Text="@Title" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginBottom="8" Sprite="BlankWhiteSquare_9" Color="#A37434FF" AlphaFactor="0.6" />

                <!-- search box and the kind of record (all, events, statements) with their counts -->
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="46" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <BrushWidget UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="400" SuggestedHeight="46" HorizontalAlignment="Left" VerticalAlignment="Center" MarginRight="8" IsVisible="@IsSearchOpen" Brush="SaveLoad.Search.Button">
                      <Children>
                        <EditableTextWidget UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="8" MarginBottom="8" MarginLeft="10" MarginRight="10" Brush="SaveLoad.Search.InputText" DefaultSearchText="@SearchPlaceholder" Text="@SearchText" />
                      </Children>
                    </BrushWidget>
                    <!-- each button keeps the width of its own text; the selected one only changes colour (a StretchToParent child inside a CoverChildren button made it fill the row) -->
                    <ListPanel DataSource="{Records}" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <ItemTemplate>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="38" MarginRight="8" HorizontalAlignment="Left" VerticalAlignment="Center" Command.Click="ExecuteSelect">
                          <Children>
                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="@Color" AlphaFactor="0.55">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="14" Brush="Popup.Title.Text" Brush.FontSize="18" Brush.FontColor="#FFFFFFFF" Text="@Text" />
                              </Children>
                            </Widget>
                          </Children>
                        </ButtonWidget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </ListPanel>

                <!-- categories present, with their counts; click one to see only it, click it again to see all -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="34" MarginTop="8" ClipContents="true">
                  <Children>
                    <ListPanel DataSource="{Categories}" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <ItemTemplate>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginRight="6" HorizontalAlignment="Left" Command.Click="ExecuteSelect">
                          <Children>
                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="@Color" AlphaFactor="0.55">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#FFFFFFFF" Text="@Text" />
                              </Children>
                            </Widget>
                          </Children>
                        </ButtonWidget>
                      </ItemTemplate>
                    </ListPanel>
                  </Children>
                </Widget>

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="596" MarginTop="6">
                  <Children>
                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="20" AutoHideScrollBars="true" ClipRect="FeedClip" InnerPanel="FeedClip\FeedList" VerticalScrollbar="..\FeedBarHolder\FeedBar">
                      <Children>
                        <Widget Id="FeedClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="FeedList" DataSource="{Cards}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>

                                    <!-- the line that opens a day -->
                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginRight="6" MarginTop="26" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsHeader">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="22" Brush.FontColor="#C9B48AFF" Brush.TextHorizontalAlignment="Left" Text="@HeaderText" />
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginTop="4" Sprite="BlankWhiteSquare_9" Color="#A37434FF" AlphaFactor="0.6" />
                                      </Children>
                                    </ListPanel>

                                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="10" MarginRight="6" MarginTop="22" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@IsCard">
                                      <Children>
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="30" Brush.FontColor="#D8B98AFF" Brush.TextHorizontalAlignment="Center" Text="@Title" />
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" Brush="Popup.Title.Text" Brush.FontSize="17" Brush.FontColor="#E8963CFF" Brush.TextHorizontalAlignment="Center" Text="@Chapter" IsVisible="@HasChapter" />
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" Brush="Popup.Title.Text" Brush.FontSize="20" Brush.FontColor="#FFFFFFFF" Brush.TextHorizontalAlignment="Center" Text="@Participants" IsVisible="@HasParticipants" />
                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#B9A781FF" Brush.TextHorizontalAlignment="Center" Text="@Place" IsVisible="@HasPlace" />
                                        <!-- the event's picture, in a gold frame -->
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="648" SuggestedHeight="328" HorizontalAlignment="Center" MarginTop="12" Sprite="BlankWhiteSquare_9" Color="#A37434FF" IsVisible="@HasImage">
                                          <Children>
                                            <AILegacyImageWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="640" SuggestedHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center" ImagePath="@ImagePath" />
                                          </Children>
                                        </Widget>
                                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="24" MarginRight="24" MarginTop="10" Brush="Popup.Title.Text" Brush.FontSize="20" Brush.FontColor="#FFFFFFFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Text" />

                                        <!-- a statement's decisions, each with its colored kind -->
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasDecisions">
                                          <Children>
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="19" Brush.FontColor="#D8B98AFF" Brush.TextHorizontalAlignment="Center" Text="@DecisionsTitle" />
                                            <ListPanel DataSource="{Decisions}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <ItemTemplate>
                                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="60" MarginRight="60" MarginTop="6">
                                                  <Children>
                                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="130" SuggestedHeight="28" HorizontalAlignment="Left" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="@Color" AlphaFactor="0.55">
                                                      <Children>
                                                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#FFFFFFFF" Brush.TextHorizontalAlignment="Center" Text="@Label" />
                                                      </Children>
                                                    </Widget>
                                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="142" MarginTop="2" Brush="Popup.Title.Text" Brush.FontSize="18" Brush.FontColor="#FFFFFFFF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" Text="@Text" />
                                                  </Children>
                                                </Widget>
                                              </ItemTemplate>
                                            </ListPanel>
                                          </Children>
                                        </ListPanel>

                                        <!-- an event's consequences: where they fall, then the bad (red) and the good (green) -->
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasEffects">
                                          <Children>
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="17" Brush.FontColor="#C9B48AFF" Brush.TextHorizontalAlignment="Center" Text="@EffectsTitle" />
                                            <ListPanel DataSource="{EffectLines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                                              <ItemTemplate>
                                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="24" MarginRight="24" MarginTop="4">
                                                  <Children>
                                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="6" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#B9A781FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Text" IsVisible="@IsPlace" />
                                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#A8C49CFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Text" IsVisible="@IsGood" />
                                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="16" Brush.FontColor="#D09A8CFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Text" IsVisible="@IsBad" />
                                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="18" Brush.FontColor="#FFFFFFFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Text" IsVisible="@IsPlain" />
                                                  </Children>
                                                </Widget>
                                              </ItemTemplate>
                                            </ListPanel>
                                          </Children>
                                        </ListPanel>

                                        <!-- the outbreak an event set off -->
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="14" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@HasDisease">
                                          <Children>
                                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="19" Brush.FontColor="#D8B98AFF" Brush.TextHorizontalAlignment="Center" Text="@DiseaseTitle" />
                                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="24" MarginRight="24" MarginTop="4" Brush="Popup.Title.Text" Brush.FontSize="18" Brush.FontColor="#C7D36BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Top" Text="@Disease" />
                                          </Children>
                                        </ListPanel>

                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="14" IsVisible="@HasTags">
                                          <Children>
                                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare_9" Color="@TagColor" AlphaFactor="0.5">
                                              <Children>
                                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" Brush="Popup.Title.Text" Brush.FontSize="15" Brush.FontColor="#E8E0D0FF" Text="@Tag" />
                                              </Children>
                                            </Widget>
                                            <Widget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" Sprite="BlankWhiteSquare_9" Color="#3B3A4AFF" AlphaFactor="0.5">
                                              <Children>
                                                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" Brush="Popup.Title.Text" Brush.FontSize="15" Brush.FontColor="#E8E0D0FF" Text="@When" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </Widget>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginTop="20" Sprite="BlankWhiteSquare_9" Color="#FFFFFFFF" AlphaFactor="0.25" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ListPanel>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Widget Id="FeedBarHolder" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="16" HorizontalAlignment="Right">
                      <Children>
                        <ScrollbarWidget Id="FeedBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" AlignmentAxis="Vertical" Handle="FeedHandle" MaxValue="100" MinValue="0" MarginTop="4" MarginBottom="4">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="3" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#A37434FF" AlphaFactor="0.6" />
                            <Widget Id="FeedHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="9" SuggestedHeight="40" MinHeight="20" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#C9B48AFF" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="70" MarginTop="14" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="64" MarginRight="24" Brush="Popup.Done.Button" Command.Click="ExecuteAction" IsVisible="@HasAction">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@ActionText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="220" SuggestedHeight="64" MarginRight="24" Brush="Popup.Done.Button" Command.Click="ExecuteSearchToggle">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@SearchToggleText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="290" SuggestedHeight="64" MarginRight="24" Brush="Popup.Done.Button" Command.Click="ExecuteToggle">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@ToggleText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="251" SuggestedHeight="64" Brush="Popup.Cancel.Button" Command.Click="ExecuteClose">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@CloseText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" IsEnabled="false" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
