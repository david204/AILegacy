<Prefab>
  <Constants>
    <Constant Name="PanelWidth" Value="1020" />
    <Constant Name="PanelHeight" Value="860" />
  </Constants>
  <Window>
    <!-- Fondo oscuro: tapa y bloquea las opciones de diálogo del juego mientras dura la charla -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.65">
      <Children>

        <!-- Panel principal -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!PanelWidth" SuggestedHeight="!PanelHeight" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" />

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="40" MarginRight="40" MarginTop="18" MarginBottom="22" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <!-- Título y subtítulo -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52" Brush="Popup.Title.Text" Text="@Title" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" Brush="Popup.Title.Text" Brush.FontSize="20" Brush.FontColor="#C9B48AFF" Text="@Subtitle" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" MarginTop="6" MarginBottom="8" Sprite="BlankWhiteSquare_9" Color="#A37434FF" AlphaFactor="0.6" />

                <!-- Historial con scroll -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="560" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.35">
                  <Children>
                    <ScrollablePanel Id="ChatScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="22" AutoHideScrollBars="true" ClipRect="ChatClip" InnerPanel="ChatClip\ChatLines" VerticalScrollbar="..\ChatScrollbarHolder\ChatScrollbar">
                      <Children>
                        <Widget Id="ChatClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="ChatLines" DataSource="{Lines}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" MarginRight="12" MarginTop="10" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="21" Brush.FontColor="@NameColor" Brush.TextHorizontalAlignment="Left" Text="@Speaker" IsVisible="@HasSpeaker" />
                                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="Popup.Title.Text" Brush.FontSize="22" Brush.FontColor="@TextColor" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" Text="@Text" />
                                  </Children>
                                </ListPanel>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>

                    <Widget Id="ChatScrollbarHolder" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="20" HorizontalAlignment="Right">
                      <Children>
                        <AILegacyScrollbarWidget Id="ChatScrollbar" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" AlignmentAxis="Vertical" Handle="ChatScrollHandle" MaxValue="100" MinValue="0" MarginTop="6" MarginBottom="6" ScrollVersion="@ScrollVersion">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="3" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#A37434FF" AlphaFactor="0.6" />
                            <Widget Id="ChatScrollHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="10" SuggestedHeight="40" MinHeight="20" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#C9B48AFF" />
                          </Children>
                        </AILegacyScrollbarWidget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>

                <!-- "Está pensando..." -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="4" Brush="Popup.Title.Text" Brush.FontSize="19" Brush.FontColor="#B0B0B0FF" Text="@WaitingText" IsVisible="@IsWaiting" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="4" IsHidden="@IsWaiting" />

                <!-- Caja de texto -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.55">
                  <Children>
                    <EditableTextWidget Id="ChatInput" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="14" MarginTop="10" MarginBottom="10" Brush="Review.NameInput.Text" Brush.TextHorizontalAlignment="Left" RealText="@InputText" IsEnabled="@CanType" />
                  </Children>
                </Widget>

                <!-- Botones -->
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="70" MarginTop="10" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="251" SuggestedHeight="64" MarginRight="30" Brush="Popup.Cancel.Button" Command.Click="ExecuteClose">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@CloseText" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="251" SuggestedHeight="64" Brush="Popup.Done.Button" Command.Click="ExecuteSend" IsEnabled="@CanSend">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Button.Text" Text="@SendText" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

              </Children>
            </ListPanel>

            <!-- Marco -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" IsEnabled="false" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />

          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
