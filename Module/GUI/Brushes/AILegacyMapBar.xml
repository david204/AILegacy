<Brushes>
  <!-- Background and icon for the map bar "Memories" button. The layer name must match the element's StringId -->
  <Brush Name="AILegacy.MapBar.Left.Button.Backgrounds" OverrideBrush="MapBar.Left.Button.Backgrounds">
    <Layers>
      <BrushLayer Name="ailegacy_memories" Sprite="MapBar\bottom_left_button5_quest" />
    </Layers>
  </Brush>
  <Brush Name="AILegacy.MapBar.Left.Icons" OverrideBrush="MapBar.Left.Icons">
    <Layers>
      <!-- A book of the game's own interface (ui_group1, always loaded). The multiplayer pencil it replaces lives in a lobby sprite group -->
      <BrushLayer Name="ailegacy_memories" Sprite="StdAssets\history_button" YOffset="1" ExtendTop="4" ExtendBottom="4" ExtendLeft="4" ExtendRight="4" ImageFit.Type="Contain" ImageFit.VerticalAlignment="Center" ImageFit.HorizontalAlignment="Center" />
    </Layers>
  </Brush>
</Brushes>
